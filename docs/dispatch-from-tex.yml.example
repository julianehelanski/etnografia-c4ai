# Exemplo de workflow para o repositório `julianehelanski/etnografia` (o repo .tex).
#
# Cole o conteúdo abaixo em `.github/workflows/notify-c4ai.yml` no repo etnografia.
#
# Função: a cada push que toque um arquivo capituloN.tex, dispara um evento
# `repository_dispatch` no repo etnografia-c4ai, que por sua vez roda
# `infranodus/run_all.py` e commita os PNG/GEXF/relatórios atualizados.
#
# Pré-requisitos (no repo etnografia):
#   - Settings → Secrets and variables → Actions → New repository secret
#     - Name:  C4AI_DISPATCH_PAT
#     - Value: Personal Access Token (fine-grained) com permissão
#              "Contents: read & write" no repo etnografia-c4ai.
#              (Em PATs clássicos: escopo `repo`.)
#
# Pré-requisitos (no repo etnografia-c4ai):
#   - Se este repo for privado, criar o secret ETNOGRAFIA_PAT com um PAT
#     que tenha permissão de leitura no repo etnografia. Se for público,
#     o workflow já usa GITHUB_TOKEN como fallback.

name: Notifica etnografia-c4ai

on:
  push:
    branches: [main]
    paths:
      - "capitulo*.tex"
      - "**/capitulo*.tex"

jobs:
  dispatch:
    runs-on: ubuntu-latest
    steps:
      - name: Disparar repository_dispatch
        uses: peter-evans/repository-dispatch@v3
        with:
          token: ${{ secrets.C4AI_DISPATCH_PAT }}
          repository: julianehelanski/etnografia-c4ai
          event-type: thesis-updated
          # client_payload chega na Action de análise como
          # ${{ github.event.client_payload.* }} e é usado na mensagem de commit.
          client-payload: |-
            {
              "sha": "${{ github.sha }}",
              "ref": "${{ github.ref }}",
              "actor": "${{ github.actor }}"
            }
